<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aast.booking.employee.EmployeeDashboardController"
            style="-fx-background-color: #F5F7FA;"
            nodeOrientation="RIGHT_TO_LEFT"
            prefWidth="1200" prefHeight="780">
    <stylesheets>
        <java.lang.String fx:value="/css/dashboard-common.css"/>
        <java.lang.String fx:value="/css/employee.css"/>
    </stylesheets>

    <!-- ═══ SIDEBAR (Left) ═══════════════════════════════════════════ -->
    <left>
        <VBox styleClass="bm-sidebar" spacing="6">
            <padding><Insets top="24" right="16" bottom="20" left="16"/></padding>

            <!-- Logo / Title -->
            <VBox spacing="2" style="-fx-padding: 0 0 16 0;">
                <Label text="نظام حجز القاعات" styleClass="bm-sidebar-title" wrapText="true"/>
                <Label text="الأكاديمية العربية" styleClass="bm-sidebar-subtitle"/>
                <Label fx:id="userRoleLabel" text="موظف" style="-fx-font-size:11px;-fx-text-fill:#D4AF37;-fx-font-weight:bold;"/>
            </VBox>

            <!-- Divider -->
            <Region styleClass="bm-divider" maxWidth="Infinity"/>

            <!-- Welcome -->
            <Label fx:id="userNameLabel" text="مستخدم" styleClass="bm-sidebar-subtitle" wrapText="true"
                   style="-fx-padding: 8 4; -fx-font-style:italic;"/>

            <!-- Nav Buttons -->
            <Button fx:id="btnDashboard" text="🏠  لوحة التحكم" maxWidth="Infinity"
                    styleClass="bm-nav-btn-active" onAction="#showDashboard"/>
            <Button fx:id="btnNewBooking" text="📋  طلب حجز جديد" maxWidth="Infinity"
                    styleClass="bm-nav-btn" onAction="#showNewBooking"/>
            <Button fx:id="btnNotifications" text="🔔  الإشعارات" maxWidth="Infinity"
                    styleClass="bm-nav-btn" onAction="#showNotifications"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Logout -->
            <Region styleClass="bm-divider" maxWidth="Infinity"/>
            <Button text="🚪  تسجيل الخروج" maxWidth="Infinity"
                    styleClass="bm-logout-btn" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ═══ MAIN CONTENT ═════════════════════════════════════════════ -->
    <center>
        <VBox spacing="0">

            <!-- ─── Top Header ───────────────────────────────────── -->
            <HBox styleClass="bm-header" alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="pageTitle" text="لوحة التحكم" styleClass="bm-header-title"/>
                    <Label fx:id="pageSubtitle" text="نظرة عامة على طلبات الحجز" styleClass="bm-header-subtitle"/>
                </VBox>
            </HBox>

            <!-- ─── Page Content (Stack) ─────────────────────────── -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                <!-- Content is loaded dynamically by the controller -->
                <Label text="جاري التحميل..." style="-fx-font-size:14px;-fx-text-fill:#9CA3AF;"/>
            </StackPane>
        </VBox>
    </center>

</BorderPane>
