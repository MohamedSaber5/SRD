<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aast.booking.employee.EmployeeDashboardController"
            styleClass="dashboard-root"
            stylesheets="@/css/employee.css"
            prefWidth="1200" prefHeight="780">

    <!-- ══════════════ SIDEBAR (Left) ══════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240" spacing="0">

            <!-- Logo / Brand -->
            <VBox styleClass="sidebar-brand" alignment="CENTER" spacing="6">
                <padding><Insets top="24" right="20" bottom="20" left="20"/></padding>
                <Label text="🎓" styleClass="brand-icon"/>
                <Label text="نظام حجز القاعات" styleClass="brand-title"/>
                <Label text="الأكاديمية العربية" styleClass="brand-subtitle"/>
            </VBox>

            <!-- User Profile Card -->
            <VBox styleClass="sidebar-user-card" alignment="CENTER_LEFT" spacing="4">
                <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👤" style="-fx-font-size: 28px;
                           -fx-background-color: #D4AF3730;
                           -fx-background-radius: 50%;
                           -fx-padding: 6 8;"/>
                    <VBox spacing="2">
                        <Label fx:id="userNameLabel" text="مستخدم" styleClass="sidebar-user-name"/>
                        <Label fx:id="userRoleLabel" text="موظف" styleClass="sidebar-user-role"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Divider -->
            <Separator opacity="0.3">
                <padding><Insets top="4" bottom="4"/></padding>
            </Separator>

            <!-- Navigation -->
            <VBox styleClass="nav-section" spacing="4" VBox.vgrow="ALWAYS">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                <!-- Dashboard -->
                <VBox fx:id="navDashboard" styleClass="nav-item, nav-active" onMouseClicked="#showDashboard">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <padding><Insets top="11" right="14" bottom="11" left="14"/></padding>
                        <Label text="🏠" styleClass="nav-icon"/>
                        <Label text="لوحة التحكم" styleClass="nav-label"/>
                    </HBox>
                </VBox>

                <!-- New Booking -->
                <VBox fx:id="navNewBooking" styleClass="nav-item" onMouseClicked="#showNewBooking">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <padding><Insets top="11" right="14" bottom="11" left="14"/></padding>
                        <Label text="➕" styleClass="nav-icon"/>
                        <Label text="طلب حجز جديد" styleClass="nav-label"/>
                    </HBox>
                </VBox>

                <!-- Notifications -->
                <VBox fx:id="navNotifications" styleClass="nav-item" onMouseClicked="#showNotifications">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <padding><Insets top="11" right="14" bottom="11" left="14"/></padding>
                        <Label text="🔔" styleClass="nav-icon"/>
                        <Label text="الإشعارات" styleClass="nav-label" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="notifBadge" text="0" styleClass="notif-badge" visible="false"/>
                    </HBox>
                </VBox>

            </VBox>

            <!-- Logout -->
            <VBox styleClass="sidebar-footer">
                <padding><Insets top="12" right="12" bottom="20" left="12"/></padding>
                <Separator opacity="0.3">
                    <padding><Insets bottom="12"/></padding>
                </Separator>
                <VBox styleClass="nav-item, nav-logout" onMouseClicked="#handleLogout">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <padding><Insets top="11" right="14" bottom="11" left="14"/></padding>
                        <Label text="🚪" styleClass="nav-icon"/>
                        <Label text="تسجيل الخروج" styleClass="nav-label"/>
                    </HBox>
                </VBox>
            </VBox>

        </VBox>
    </left>

    <!-- ══════════════ CONTENT AREA (Center) ══════════════ -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <!-- Content is loaded dynamically by the controller -->
            <Label text="جاري التحميل..." styleClass="loading-placeholder"/>
        </StackPane>
    </center>

</BorderPane>
