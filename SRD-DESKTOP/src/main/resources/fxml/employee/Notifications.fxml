<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Notifications.fxml — Mirrors NotificationsPage.jsx -->

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.aast.booking.employee.NotificationsController">

    <ScrollPane fitToWidth="true" styleClass="main-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="16" stylesheets="@../../css/employee.css">
            <padding><Insets bottom="20" left="28" right="28" top="20" /></padding>

            <!-- Toolbar (mark all read) -->
            <HBox alignment="CENTER_LEFT" spacing="16" stylesheets="@../../css/employee.css">
                <Region stylesheets="@../../css/employee.css" HBox.hgrow="ALWAYS" />
                <Button fx:id="markAllReadButton" onAction="#handleMarkAllRead" styleClass="btn-outline" stylesheets="@../../css/employee.css" text="✓  تحديد الكل كمقروء" visible="false" />
            </HBox>

               <!-- Loading -->
            <ProgressIndicator fx:id="loadingIndicator" maxHeight="48" maxWidth="48" styleClass="spinner" stylesheets="@../../css/employee.css" visible="true" />

            <!-- Empty state -->
            <VBox fx:id="emptyStateLabel" alignment="CENTER" spacing="14" style="-fx-padding: 60 0; -fx-opacity: 0.4;" stylesheets="@../../css/employee.css" visible="false">
                <Label style="-fx-font-size: 56px;" text="🔕" />
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="لا يوجد أي إشعارات حالياً" />
            </VBox>

            <!-- Notification cards (injected by controller) -->
            <VBox fx:id="notificationsContainer" spacing="10" stylesheets="@../../css/employee.css" />

        </VBox>
    </ScrollPane>
</VBox>
