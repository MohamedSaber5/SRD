<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<!-- Notifications.fxml — Mirrors NotificationsPage.jsx -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.aast.booking.employee.NotificationsController"
      spacing="0">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="main-scroll">
        <VBox spacing="16">
            <padding><Insets top="20" right="28" bottom="20" left="28"/></padding>

            <!-- Toolbar (mark all read) -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="markAllReadButton" text="✓  تحديد الكل كمقروء"
                        onAction="#handleMarkAllRead" styleClass="btn-outline" visible="false"/>
            </HBox>

            <!-- Loading -->
            <ProgressIndicator fx:id="loadingIndicator" maxWidth="48" maxHeight="48"
                               visible="true" styleClass="spinner"/>

            <!-- Empty state -->
            <VBox fx:id="emptyStateLabel" visible="false" alignment="CENTER" spacing="14"
                  style="-fx-padding: 60 0; -fx-opacity: 0.4;">
                <Label text="🔕" style="-fx-font-size: 56px;"/>
                <Label text="لا يوجد أي إشعارات حالياً"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            </VBox>

            <!-- Notification cards (injected by controller) -->
            <VBox fx:id="notificationsContainer" spacing="10"/>

        </VBox>
    </ScrollPane>
</VBox>
