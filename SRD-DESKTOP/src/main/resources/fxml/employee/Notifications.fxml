<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<!-- Notifications.fxml — Mirrors NotificationsPage.jsx -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.aast.booking.employee.NotificationsController"
      spacing="0">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="24">
            <padding><Insets top="32" right="36" bottom="32" left="36"/></padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="الإشعارات" styleClass="page-title"/>
                    <Label text="متابعة تحديثات طلبات الحجز الخاصة بك" styleClass="page-subtitle"/>
                </VBox>
                <Button fx:id="markAllReadButton" text="تحديد الكل كمقروء"
                        onAction="#handleMarkAllRead" styleClass="btn-outline" visible="false"/>
            </HBox>

            <!-- Loading -->
            <ProgressIndicator fx:id="loadingIndicator" maxWidth="48" maxHeight="48"
                               visible="true" styleClass="spinner"/>

            <!-- Empty state -->
            <VBox fx:id="emptyStateLabel" visible="false" alignment="CENTER" spacing="14"
                  style="-fx-padding: 80 0; -fx-opacity: 0.4;">
                <Label text="🔕" style="-fx-font-size: 60px;"/>
                <Label text="لا يوجد أي إشعارات حالياً"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            </VBox>

            <!-- Notification cards (injected by controller) -->
            <VBox fx:id="notificationsContainer" spacing="12"/>

        </VBox>
    </ScrollPane>
</VBox>
