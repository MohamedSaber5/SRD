<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Booking List = Main Dashboard Content View -->
<!-- Mirrors UserDashboard.jsx -->

<VBox nodeOrientation="RIGHT_TO_LEFT" spacing="0" styleClass="booking-list-root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.aast.booking.employee.BookingListController">

    <ScrollPane fitToWidth="true" styleClass="main-scroll" VBox.vgrow="ALWAYS">

        <VBox spacing="20" stylesheets="@../../css/employee.css">
            <padding><Insets bottom="24" left="28" right="28" top="24" /></padding>

            <!-- ══ Welcome ══ -->
            <HBox alignment="CENTER_RIGHT" spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="welcomeLabel" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#191c1e;" text="مرحباً" />
                    <Label fx:id="subtitleLabel" style="-fx-font-size:12px;-fx-text-fill:#737780;" text="نظرة عامة على طلبات الحجز" />
                </VBox>
            </HBox>

            <!-- ══ Stats Cards (3 columns) ══ -->
            <HBox prefHeight="106.0" prefWidth="324.0" spacing="14">
                <!-- Approved -->
                <VBox alignment="CENTER" spacing="6" styleClass="stat-card, stat-approved" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="20" left="18" right="18" top="20" /></padding>
                    <Label style="-fx-font-size: 22px;" text="✅" />
                    <Label fx:id="approvedCountLabel" styleClass="stat-number, stat-number-approved" text="0" />
                    <Label styleClass="stat-label" text="طلبات مقبولة" />
                </VBox>
                <!-- Pending -->
                <VBox alignment="CENTER" spacing="6" styleClass="stat-card, stat-pending" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="20" left="18" right="18" top="20" /></padding>
                    <Label style="-fx-font-size: 22px;" text="⏳" />
                    <Label fx:id="pendingCountLabel" styleClass="stat-number, stat-number-pending" text="0" />
                    <Label styleClass="stat-label" text="قيد الانتظار" />
                </VBox>
                <!-- Rejected -->
                <VBox alignment="CENTER" spacing="6" styleClass="stat-card, stat-rejected" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="20" left="18" right="18" top="20" /></padding>
                    <Label style="-fx-font-size: 22px;" text="❌" />
                    <Label fx:id="rejectedCountLabel" styleClass="stat-number, stat-number-rejected" text="0" />
                    <Label styleClass="stat-label" text="طلبات مرفوضة" />
                </VBox>
            </HBox>

            <!-- ══ Bookings Section ══ -->
            <VBox spacing="12">
                <HBox alignment="CENTER_RIGHT">
                    <Label styleClass="section-title" text="📋  حالة الطلبات الأخيرة" />
                </HBox>

                <!-- Loading indicator -->
                <ProgressIndicator fx:id="loadingIndicator" maxHeight="48" maxWidth="48" styleClass="spinner" visible="true" />

                <!-- Empty state -->
                <VBox fx:id="emptyStateLabel" alignment="CENTER" spacing="12" style="-fx-padding: 40 0;" visible="false">
                    <Label style="-fx-font-size: 48px;" text="📭" />
                    <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #191c1e;" text="لا توجد طلبات حجز حتى الآن" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #737780;" text="اضغط على «طلب حجز جديد» في الشريط الجانبي للبدء" />
                </VBox>

                <!-- Booking cards injected here by controller -->
                <VBox fx:id="bookingsContainer" spacing="10" />
            </VBox>

        </VBox>
    </ScrollPane>

</VBox>
