<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<!-- BookingForm.fxml — 3-Step Booking Form (No room selection - system assigns) -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.aast.booking.employee.BookingFormController"
      styleClass="booking-form-root"
      spacing="0">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="main-scroll">
        <VBox spacing="16">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- ══ Header ══ -->
            <VBox spacing="3">
                <Label fx:id="formTitleLabel" text="طلب حجز قاعة جديد" styleClass="page-title"/>
                <Label text="يرجى تعبئة البيانات في الخطوات التالية" styleClass="page-subtitle"/>
                <Label fx:id="formNoticeLabel" text="" styleClass="form-notice" wrapText="true"
                       managed="false" visible="false"/>
            </VBox>

            <!-- ══ Step Indicator ══ -->
            <HBox alignment="CENTER" spacing="0" styleClass="step-bar">
                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="step1Indicator" text="1" styleClass="step-indicator, step-active"/>
                    <Label text="الأساسيات" styleClass="step-label"/>
                </VBox>
                <Region styleClass="step-connector" prefWidth="50" maxHeight="2"/>
                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="step2Indicator" text="2" styleClass="step-indicator, step-inactive"/>
                    <Label text="المسؤول" styleClass="step-label"/>
                </VBox>
                <Region styleClass="step-connector" prefWidth="50" maxHeight="2"/>
                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="step3Indicator" text="3" styleClass="step-indicator, step-inactive"/>
                    <Label text="المتطلبات" styleClass="step-label"/>
                </VBox>
            </HBox>

            <!-- ══════════════════════════════════════ -->
            <!-- STEP 1: Basic Info                     -->
            <!-- ══════════════════════════════════════ -->
            <VBox fx:id="step1Pane" spacing="12" visible="true">
                <Label text="نوع القاعة والوقت" styleClass="step-section-title"/>

                <!-- Hall Category -->
                <VBox spacing="5">
                    <Label text="نوع القاعة" styleClass="field-label"/>
                    <HBox spacing="10">
                        <Button fx:id="btnCategoryLecture" onAction="#selectLectureCategory"
                                text="🎓  قاعة محاضرات"
                                styleClass="category-btn" HBox.hgrow="ALWAYS"
                                maxWidth="Infinity" prefHeight="58"/>
                        <Button fx:id="btnCategoryMulti" onAction="#selectMultiCategory"
                                text="🏛  متعددة الأغراض"
                                styleClass="category-btn" HBox.hgrow="ALWAYS"
                                maxWidth="Infinity" prefHeight="58"/>
                    </HBox>
                </VBox>

                <!-- Date -->
                <VBox spacing="5">
                    <Label text="تاريخ الفعالية" styleClass="field-label"/>
                    <DatePicker fx:id="datePicker" promptText="اختر التاريخ..."
                                maxWidth="Infinity" styleClass="form-input"
                                onAction="#onDateChanged"/>
                </VBox>

                <!-- Time (Slot or Hour) -->
                <VBox spacing="5">
                    <Label text="الفترة الزمنية" styleClass="field-label"/>
                    <!-- Lecture slots -->
                    <HBox fx:id="slotBox">
                        <ComboBox fx:id="slotComboBox" promptText="اختر فترة المحاضرة..."
                                  maxWidth="Infinity" styleClass="form-combo" HBox.hgrow="ALWAYS"
                                  onAction="#onDateChanged"/>
                    </HBox>
                    <!-- Multi-purpose hour picker -->
                    <HBox fx:id="multiTimeBox" spacing="10" visible="false">
                        <ComboBox fx:id="timeFromCombo" promptText="من..."
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                  styleClass="form-combo" onAction="#onTimeFromChanged"/>
                        <Label text="→" style="-fx-font-size: 16px; -fx-text-fill: #9CA3AF;"
                               alignment="CENTER" minWidth="20"/>
                        <ComboBox fx:id="timeToCombo" promptText="إلى..."
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="form-combo"/>
                    </HBox>
                    <!-- Lead time error -->
                    <Label fx:id="leadTimeErrorLabel" text="" styleClass="error-label"
                           visible="false" wrapText="true"/>
                </VBox>

                <!-- Purpose -->
                <VBox spacing="5">
                    <Label text="الغرض من الاستخدام" styleClass="field-label"/>
                    <TextArea fx:id="purposeField"
                              promptText="وصف موجز للفعالية أو الاجتماع..."
                              prefRowCount="3" styleClass="form-textarea"/>
                </VBox>

                <!-- Capacity -->
                <VBox spacing="5">
                    <Label text="عدد الحضور المتوقع" styleClass="field-label"/>
                    <TextField fx:id="capacityField" promptText="مثال: 50"
                               styleClass="form-input"/>
                </VBox>
            </VBox>

            <!-- ══════════════════════════════════════ -->
            <!-- STEP 2: Responsible Person             -->
            <!-- ══════════════════════════════════════ -->
            <VBox fx:id="step2Pane" spacing="12" visible="false">
                <Label text="بيانات المسؤول عن الفعالية" styleClass="step-section-title"/>

                <VBox spacing="5">
                    <Label text="الاسم الكامل" styleClass="field-label"/>
                    <TextField fx:id="respNameField" promptText="مثال: أحمد محمد إبراهيم"
                               styleClass="form-input"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="المسمى الوظيفي / الدرجة العلمية" styleClass="field-label"/>
                    <TextField fx:id="respJobField" promptText="مثال: دكتور / مهندس / أستاذ"
                               styleClass="form-input"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="رقم المحمول" styleClass="field-label"/>
                    <TextField fx:id="respMobileField" promptText="مثال: 01012345678"
                               styleClass="form-input"/>
                </VBox>
            </VBox>

            <!-- ══════════════════════════════════════ -->
            <!-- STEP 3: Requirements                   -->
            <!-- ══════════════════════════════════════ -->
            <VBox fx:id="step3Pane" spacing="10" visible="false">
                <Label text="المتطلبات التقنية" styleClass="step-section-title"/>

                <HBox styleClass="req-card" spacing="12" alignment="CENTER_LEFT">
                    <CheckBox fx:id="reqLaptopCheck"/>
                    <VBox spacing="1">
                        <Label text="جهاز حاسب آلي (Laptop)" styleClass="req-title"/>
                        <Label text="جهاز متصل بشاشة العرض." styleClass="req-desc"/>
                    </VBox>
                </HBox>

                <HBox styleClass="req-card" spacing="12" alignment="CENTER_LEFT">
                    <CheckBox fx:id="reqVideoConfCheck"/>
                    <VBox spacing="1">
                        <Label text="نظام Video Conference" styleClass="req-title"/>
                        <Label text="كاميرات ومعدات البث للاجتماعات عن بعد." styleClass="req-desc"/>
                    </VBox>
                </HBox>

                <VBox styleClass="req-card" spacing="8">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <CheckBox fx:id="reqMicCheck"/>
                        <VBox spacing="1">
                            <Label text="ميكروفونات متحركة" styleClass="req-title"/>
                            <Label text="ميكروفونات لاسلكية للحوار." styleClass="req-desc"/>
                        </VBox>
                    </HBox>
                    <HBox fx:id="micQtyRow" spacing="8" alignment="CENTER_LEFT" visible="false">
                        <padding><Insets left="28"/></padding>
                        <Label text="العدد:" styleClass="field-label"/>
                        <Spinner fx:id="reqMicQtySpinner" prefWidth="80" styleClass="form-spinner"/>
                    </HBox>
                </VBox>

                <VBox styleClass="req-card" spacing="8">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <CheckBox fx:id="reqOtherCheck"/>
                        <VBox spacing="1">
                            <Label text="متطلبات أخرى" styleClass="req-title"/>
                            <Label text="أي متطلبات غير مذكورة أعلاه." styleClass="req-desc"/>
                        </VBox>
                    </HBox>
                    <VBox fx:id="reqOtherDetailsRow" visible="false">
                        <padding><Insets left="28"/></padding>
                        <TextArea fx:id="reqOtherDetailsField"
                                  promptText="اكتب تفاصيل المتطلبات الأخرى..."
                                  prefRowCount="2" styleClass="form-textarea"/>
                    </VBox>
                </VBox>
            </VBox>

            <!-- ══ Navigation Buttons ══ -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <padding><Insets top="8"/></padding>
                <Button fx:id="prevButton" text="→ السابق" onAction="#handlePrev"
                        styleClass="btn-secondary" visible="false"/>
                <Button fx:id="nextButton" text="التالي ←" onAction="#handleNext"
                        styleClass="btn-primary" defaultButton="true"/>
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>
