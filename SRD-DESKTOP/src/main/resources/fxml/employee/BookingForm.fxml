<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    BookingForm.fxml — 3-Step Booking Form
    RTL Arabic. All fx:id and onAction preserved — backend untouched.
    prevButton + nextButton are SINGLE instances outside step panes
    so the controller can manage them globally.
-->

<VBox alignment="TOP_CENTER" nodeOrientation="RIGHT_TO_LEFT" spacing="0" styleClass="booking-form-root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.aast.booking.employee.BookingFormController">

    <ScrollPane fitToWidth="true" styleClass="main-scroll" stylesheets="@../../css/employee.css" VBox.vgrow="ALWAYS">
        <VBox alignment="TOP_CENTER" stylesheets="@../../css/employee.css">
            <padding><Insets bottom="12" left="28" right="28" top="24" /></padding>

            <!-- Centered column -->
            <VBox alignment="TOP_CENTER" maxWidth="580" spacing="14" stylesheets="@../../css/employee.css">

                <!-- ══ Notice (hidden by default) ══ -->
                <Label fx:id="formNoticeLabel" managed="false" maxWidth="Infinity" styleClass="form-notice" stylesheets="@../../css/employee.css" text="" visible="false" wrapText="true" />

                <!-- ══ Step Indicator ══ -->
                <HBox alignment="CENTER" spacing="0" styleClass="step-bar" stylesheets="@../../css/employee.css">
                    <padding><Insets bottom="14" left="20" right="20" top="14" /></padding>
                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="step1Indicator" styleClass="step-indicator, step-active" text="1" />
                        <Label styleClass="step-label" text="الأساسيات" />
                    </VBox>
                    <Region maxHeight="2" prefWidth="50" styleClass="step-connector" />
                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="step2Indicator" styleClass="step-indicator, step-inactive" text="2" />
                        <Label styleClass="step-label" text="المسؤول" />
                    </VBox>
                    <Region maxHeight="2" prefWidth="50" styleClass="step-connector" />
                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="step3Indicator" styleClass="step-indicator, step-inactive" text="3" />
                        <Label styleClass="step-label" text="المتطلبات" />
                    </VBox>
                </HBox>

                <!-- Hidden title for controller -->
                <Label fx:id="formTitleLabel" managed="false" stylesheets="@../../css/employee.css" text="" visible="false" />

                <!-- ══════════════════════════════════════
                     STEP 1: Basic Info
                     ══════════════════════════════════════ -->
                <VBox fx:id="step1Pane" spacing="0" stylesheets="@../../css/employee.css" visible="true">
                    <VBox spacing="16" styleClass="form-card">
                        <padding><Insets bottom="22" left="22" right="22" top="22" /></padding>

                        <Label styleClass="step-section-title" text="نوع القاعة والوقت" />

                        <!-- Category toggle -->
                        <VBox spacing="6">
                            <Label styleClass="field-label" text="نوع القاعة" />
                            <HBox spacing="0" styleClass="toggle-group">
                                <Button fx:id="btnCategoryLecture" maxWidth="Infinity" onAction="#selectLectureCategory" prefHeight="40" styleClass="toggle-btn, toggle-btn-right" text="🎓  قاعة محاضرات" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnCategoryMulti" maxWidth="Infinity" onAction="#selectMultiCategory" prefHeight="40" styleClass="toggle-btn, toggle-btn-left" text="🏛  متعددة الأغراض" HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>

                        <!-- Date -->
                        <VBox spacing="6">
                            <Label styleClass="field-label" text="تاريخ الفعالية" />
                            <DatePicker fx:id="datePicker" maxWidth="Infinity" onAction="#onDateChanged" promptText="اختر التاريخ..." styleClass="modern-date-picker" />
                        </VBox>

                        <!-- Time -->
                        <VBox spacing="6">
                            <Label styleClass="field-label" text="الفترة الزمنية" />
                            <HBox fx:id="slotBox">
                                <ComboBox fx:id="slotComboBox" maxWidth="Infinity" onAction="#onDateChanged" promptText="اختر فترة المحاضرة..." styleClass="form-combo" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <HBox fx:id="multiTimeBox" alignment="CENTER_RIGHT" spacing="10" visible="false">
                                <ComboBox fx:id="timeFromCombo" maxWidth="Infinity" onAction="#onTimeFromChanged" promptText="من..." styleClass="form-combo" HBox.hgrow="ALWAYS" />
                                <Label alignment="CENTER" minWidth="24" style="-fx-font-size: 16px; -fx-text-fill: #737780;" text="→" />
                                <ComboBox fx:id="timeToCombo" maxWidth="Infinity" promptText="إلى..." styleClass="form-combo" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <Label fx:id="leadTimeErrorLabel" styleClass="error-label" text="" visible="false" wrapText="true" />
                        </VBox>

                        <!-- Purpose -->
                        <VBox spacing="6">
                            <Label styleClass="field-label" text="الغرض من الاستخدام" />
                            <TextArea fx:id="purposeField" prefRowCount="2" promptText="وصف موجز للفعالية أو الاجتماع..." styleClass="form-textarea" />
                        </VBox>

                        <!-- Capacity -->
                        <VBox spacing="6">
                            <Label styleClass="field-label" text="عدد الحضور المتوقع" />
                            <TextField fx:id="capacityField" promptText="مثال: 50" styleClass="form-input" />
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ══════════════════════════════════════
                     STEP 2: Responsible Person
                     ══════════════════════════════════════ -->
                <VBox fx:id="step2Pane" spacing="0" stylesheets="@../../css/employee.css" visible="false">
                    <VBox spacing="16" styleClass="form-card">
                        <padding><Insets bottom="22" left="22" right="22" top="22" /></padding>

                        <Label styleClass="step-section-title" text="بيانات المسؤول عن الفعالية" />

                        <VBox spacing="6">
                            <Label styleClass="field-label" text="الاسم الكامل" />
                            <TextField fx:id="respNameField" promptText="مثال: أحمد محمد إبراهيم" styleClass="form-input" />
                        </VBox>
                        <VBox spacing="6">
                            <Label styleClass="field-label" text="المسمى الوظيفي / الدرجة العلمية" />
                            <TextField fx:id="respJobField" promptText="مثال: دكتور / مهندس / أستاذ" styleClass="form-input" />
                        </VBox>
                        <VBox spacing="6">
                            <Label styleClass="field-label" text="رقم المحمول" />
                            <TextField fx:id="respMobileField" promptText="مثال: 01012345678" styleClass="form-input" />
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ══════════════════════════════════════
                     STEP 3: Requirements
                     ══════════════════════════════════════ -->
                <VBox fx:id="step3Pane" spacing="0" stylesheets="@../../css/employee.css" visible="false">
                    <VBox spacing="12" styleClass="form-card">
                        <padding><Insets bottom="22" left="22" right="22" top="22" /></padding>

                        <Label styleClass="step-section-title" text="المتطلبات التقنية" />

                                        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="req-card">
                            <VBox spacing="1" HBox.hgrow="ALWAYS">
                                <Label styleClass="req-title" text="جهاز حاسب آلي (Laptop)" />
                                <Label styleClass="req-desc" text="جهاز متصل بشاشة العرض." />
                            </VBox>
                            <CheckBox fx:id="reqLaptopCheck" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="req-card">
                            <VBox spacing="1" HBox.hgrow="ALWAYS">
                                <Label styleClass="req-title" text="نظام Video Conference" />
                                <Label styleClass="req-desc" text="كاميرات ومعدات البث للاجتماعات عن بعد." />
                            </VBox>
                            <CheckBox fx:id="reqVideoConfCheck" />
                        </HBox>

                        <VBox spacing="8" styleClass="req-card">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <VBox spacing="1" HBox.hgrow="ALWAYS">
                                    <Label styleClass="req-title" text="ميكروفونات متحركة" />
                                    <Label styleClass="req-desc" text="ميكروفونات لاسلكية للحوار." />
                                </VBox>
                                <CheckBox fx:id="reqMicCheck" />
                            </HBox>
                            <HBox fx:id="micQtyRow" alignment="CENTER_RIGHT" spacing="8" visible="false">
                                <padding><Insets right="28" /></padding>
                                <Label styleClass="field-label" text="العدد:" />
                                <Spinner fx:id="reqMicQtySpinner" prefWidth="80" styleClass="form-spinner" />
                            </HBox>
                        </VBox>

                        <VBox spacing="8" styleClass="req-card">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <VBox spacing="1" HBox.hgrow="ALWAYS">
                                    <Label styleClass="req-title" text="متطلبات أخرى" />
                                    <Label styleClass="req-desc" text="أي متطلبات غير مذكورة أعلاه." />
                                </VBox>
                                <CheckBox fx:id="reqOtherCheck" />
                            </HBox>
                            <VBox fx:id="reqOtherDetailsRow" visible="false">
                                <padding><Insets right="28" /></padding>
                                <TextArea fx:id="reqOtherDetailsField" prefRowCount="2" promptText="اكتب تفاصيل المتطلبات الأخرى..." styleClass="form-textarea" />
                            </VBox>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ══ Navigation — inside form, bottom-left ══ -->
                <HBox alignment="CENTER_LEFT" spacing="12" stylesheets="@../../css/employee.css">
                    <padding><Insets bottom="8" top="8" /></padding>
                    <Button fx:id="prevButton" onAction="#handlePrev" prefHeight="42" prefWidth="140" styleClass="btn-secondary" text="→  السابق" visible="false" />
                    <Button fx:id="nextButton" defaultButton="true" onAction="#handleNext" prefHeight="42" prefWidth="200" styleClass="btn-primary" text="التالي  ←" />
                </HBox>

            </VBox>
        </VBox>
    </ScrollPane>

</VBox>
