<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT"
            style="-fx-background-color: #f2f4f6; -fx-font-family: 'Tajawal', 'IBM Plex Sans Arabic', 'Inter', sans-serif;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aast.booking.branchmanager.BranchManagerDashboardController">

    <stylesheets>
        <java.lang.String fx:value="/css/styles.css" />
        <java.lang.String fx:value="/css/branchmanager.css" />
    </stylesheets>

    <!-- SIDEBAR (left in code = RIGHT visually in RTL) -->
    <left>
        <VBox spacing="8" styleClass="bm-sidebar">
            <padding><Insets bottom="24" left="18" right="18" top="28" /></padding>

            <VBox spacing="3" style="-fx-padding: 0 0 20 0;">
                <Label styleClass="bm-sidebar-title" text="نظام حجز القاعات" wrapText="true" />
                <Label styleClass="bm-sidebar-subtitle" text="الأكاديمية العربية" />
                <Label fx:id="roleLabel" style="-fx-font-size:11px; -fx-text-fill:#775a19; -fx-font-weight:bold;" text="مدير الفرع" />
            </VBox>

            <Region maxWidth="Infinity" styleClass="bm-divider" />

            <Label fx:id="welcomeLabel" style="-fx-padding: 10 4 6 4; -fx-font-style:italic;" styleClass="bm-sidebar-subtitle" text="" wrapText="true" />

            <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#showDashboard" styleClass="bm-nav-btn-active" text="🏠  لوحة التحكم" />
            <Button fx:id="btnRequests"  maxWidth="Infinity" onAction="#showPendingRequests" styleClass="bm-nav-btn" text="📋  الطلبات المعلقة" />
            <Button fx:id="btnInstantBook" maxWidth="Infinity" onAction="#showInstantBooking" styleClass="bm-nav-btn" text="⚡  حجز فوري" />
            <Button fx:id="btnHistory"   maxWidth="Infinity" onAction="#showHistory" styleClass="bm-nav-btn" text="🗂  سجل الطلبات" />

            <Region VBox.vgrow="ALWAYS" />

            <Region maxWidth="Infinity" styleClass="bm-divider" />
            <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="bm-logout-btn" text="🚪  تسجيل الخروج" />
        </VBox>
    </left>

    <!-- CENTER CONTENT wrapped in ScrollPane for scrollability -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="bm-main-scroll"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="0" style="-fx-background-color: #f2f4f6;">

                <!-- Top Header Bar -->
                <HBox alignment="CENTER_RIGHT" spacing="16" styleClass="bm-header">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="pageTitle" styleClass="bm-header-title" text="لوحة التحكم" />
                        <Label fx:id="pageSubtitle" styleClass="bm-header-subtitle" text="نظرة عامة على طلبات القاعات متعددة الأغراض" />
                    </VBox>
                    <Button fx:id="ramadanBtn" onAction="#toggleRamadanMode" styleClass="bm-ramadan-off" text="🌙  تفعيل وضع رمضان" />
                </HBox>

                <!-- Page Stack -->
                <StackPane VBox.vgrow="ALWAYS" style="-fx-min-height: 600;">

                    <!-- DASHBOARD VIEW -->
                    <VBox fx:id="dashboardView" spacing="24" visible="true">
                        <padding><Insets bottom="30" left="30" right="30" top="24" /></padding>

                        <!-- Stats Row -->
                        <HBox spacing="14">
                            <VBox spacing="8" styleClass="bm-stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <Label styleClass="bm-stat-label" text="الطلبات المعلقة" />
                                <Label fx:id="statPending" styleClass="bm-stat-value" text="0" />
                            </VBox>
                            <VBox spacing="8" styleClass="bm-stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <Label styleClass="bm-stat-label" text="المعتمدة" />
                                <Label fx:id="statApproved" styleClass="bm-stat-value-green" text="0" />
                            </VBox>
                            <VBox spacing="8" styleClass="bm-stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <Label styleClass="bm-stat-label" text="المرفوضة" />
                                <Label fx:id="statRejected" styleClass="bm-stat-value-red" text="0" />
                            </VBox>
                            <VBox spacing="8" styleClass="bm-stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <Label styleClass="bm-stat-label" text="الإجمالي" />
                                <Label fx:id="statTotal" styleClass="bm-stat-value" text="0" />
                            </VBox>
                            <VBox spacing="8" styleClass="bm-stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <Label styleClass="bm-stat-label" text="طلبات طارئة" />
                                <Label fx:id="statEmergency" styleClass="bm-stat-value-orange" text="0" />
                            </VBox>
                        </HBox>

                        <!-- Pending Section Header -->
                        <HBox alignment="CENTER_RIGHT" spacing="12">
                            <Label styleClass="bm-section-title" text="الطلبات المعلقة" />
                            <Label fx:id="pendingCountBadge" styleClass="bm-count-badge" text="0" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#refreshAll" styleClass="bm-refresh-btn" text="↻  تحديث" />
                        </HBox>
                        <Label styleClass="bm-section-hint" text="يظهر هنا فقط حجوزات القاعات متعددة الأغراض" />

                        <!-- Pending Cards (scrollable) -->
                        <ScrollPane fitToWidth="true" styleClass="bm-scroll" VBox.vgrow="ALWAYS"
                                    style="-fx-min-height: 300;">
                            <FlowPane fx:id="cardsContainer" hgap="20" prefWrapLength="800" vgap="20">
                                <padding><Insets bottom="16" left="4" right="4" top="4" /></padding>
                            </FlowPane>
                        </ScrollPane>
                    </VBox>

                    <!-- PENDING REQUESTS VIEW -->
                    <VBox fx:id="pendingView" spacing="24" visible="false">
                        <padding><Insets bottom="30" left="30" right="30" top="24" /></padding>
                        <HBox alignment="CENTER_RIGHT" spacing="12">
                            <Label styleClass="bm-section-title" text="الطلبات بانتظار الاعتماد" />
                            <Label fx:id="pendingCountBadge2" styleClass="bm-count-badge" text="0" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#refreshAll" styleClass="bm-refresh-btn" text="↻  تحديث" />
                        </HBox>
                        <ScrollPane fitToWidth="true" styleClass="bm-scroll" VBox.vgrow="ALWAYS"
                                    style="-fx-min-height: 400;">
                            <FlowPane fx:id="pendingCardsContainer" hgap="20" prefWrapLength="800" vgap="20">
                                <padding><Insets bottom="16" left="4" right="4" top="4" /></padding>
                            </FlowPane>
                        </ScrollPane>
                    </VBox>

                    <!-- INSTANT BOOKING VIEW -->
                    <VBox fx:id="instantBookingView" spacing="24" visible="false">
                        <padding><Insets bottom="30" left="30" right="30" top="24" /></padding>
                        <VBox maxWidth="650" spacing="20" styleClass="bm-form-card">
                            <Label styleClass="bm-form-card-title" text="⚡ حجز فوري — قاعات متعددة الأغراض فقط" />
                            <Label styleClass="bm-form-card-hint" text="الحجوزات الفورية تُعتمد تلقائياً دون الحاجة لخطوات موافقة." wrapText="true" />
                            <Region maxWidth="Infinity" styleClass="bm-divider" />
                            <GridPane hgap="16" vgap="16">
                                <columnConstraints>
                                    <ColumnConstraints maxWidth="140" minWidth="120" />
                                    <ColumnConstraints fillWidth="true" hgrow="ALWAYS" />
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints /><RowConstraints /><RowConstraints />
                                    <RowConstraints /><RowConstraints /><RowConstraints />
                                </rowConstraints>
                                <Label styleClass="bm-form-field-label" text="التاريخ:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <DatePicker fx:id="bookDatePicker" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <Label styleClass="bm-form-field-label" text="القاعة:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <ComboBox fx:id="bookHallCombo" maxWidth="Infinity" promptText="اختر القاعة" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label styleClass="bm-form-field-label" text="وقت البداية:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <ComboBox fx:id="bookStartTimeCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label styleClass="bm-form-field-label" text="وقت الانتهاء:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <ComboBox fx:id="bookEndTimeCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <Label styleClass="bm-form-field-label" text="الغرض:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <TextField fx:id="bookPurposeField" maxWidth="Infinity" promptText="الغرض من الحجز..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                <Label styleClass="bm-form-field-label" text="المسؤول:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                <TextField fx:id="bookResponsibleField" maxWidth="Infinity" promptText="اسم المسؤول..." GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            </GridPane>
                            <Label fx:id="bookingStatusLabel" styleClass="bm-status-label" text="" wrapText="true" />
                            <Button maxWidth="Infinity" onAction="#handleInstantBooking" styleClass="bm-instant-btn" text="⚡  احجز الآن (اعتماد فوري)" />
                        </VBox>
                    </VBox>

                    <!-- HISTORY VIEW -->
                    <VBox fx:id="historyView" spacing="20" visible="false">
                        <padding><Insets bottom="30" left="30" right="30" top="24" /></padding>

                        <!-- History controls: title + date picker + status filter + refresh -->
                        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="bm-history-header">
                            <Label styleClass="bm-section-title" text="سجل الطلبات" />
                            <Region HBox.hgrow="ALWAYS" />
                            <DatePicker fx:id="historyDatePicker" prefWidth="160" promptText="بحث بالتاريخ" style="-fx-font-size: 13px;" />
                            <ComboBox fx:id="historyFilter" prefWidth="160" promptText="فلتر حسب الحالة" style="-fx-font-size:13px;" />
                            <Button onAction="#refreshHistory" styleClass="bm-refresh-btn" text="↻  تحديث" />
                        </HBox>

                        <ScrollPane fitToWidth="true" styleClass="bm-scroll" VBox.vgrow="ALWAYS"
                                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-min-height: 450; -fx-background-color: transparent;">
                            <VBox fx:id="historyCardsContainer" spacing="12" style="-fx-background-color: transparent;">
                                <padding><Insets bottom="16" left="4" right="4" top="4" /></padding>
                            </VBox>
                        </ScrollPane>
                    </VBox>

                </StackPane>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
