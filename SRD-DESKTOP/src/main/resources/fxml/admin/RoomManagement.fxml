<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane nodeOrientation="RIGHT_TO_LEFT" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aast.booking.admin.RoomManagementController">

    <!-- MAIN CONTENT -->
    <VBox spacing="20" style="-fx-background-color: transparent;">
        <padding><Insets bottom="20" left="30" right="30" top="20" /></padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20" stylesheets="@../../css/dashboard-common.css">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #001e40;" text="إدارة القاعات والمدرجات" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #5a7698;" text="التحكم الشامل في قواعد البيانات وإضافة وإزالة القاعات وتوليد التقارير." />
            </VBox>
            <Button onAction="#showAddForm" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;" text="➕  إضافة قاعة جديدة" />
        </HBox>

        <!-- Filters -->
        <VBox spacing="15" styleClass="admin-section-card">
            <HBox spacing="15">
                <TextField fx:id="searchField" promptText="ابحث برقم أو اسم القاعة..." style="-fx-background-color: #f8fafc; -fx-border-color: #e0e3e5; -fx-border-radius: 8; -fx-padding: 10;" HBox.hgrow="ALWAYS" />
                <TextField fx:id="capacityField" prefWidth="150" promptText="أدنى سعة (مثال: 50)" style="-fx-background-color: #f8fafc; -fx-border-color: #e0e3e5; -fx-border-radius: 8; -fx-padding: 10;" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <ComboBox fx:id="typeFilter" prefWidth="180" style="-fx-background-color: #f8fafc; -fx-border-color: #e0e3e5; -fx-border-radius: 8; -fx-padding: 4;" />
                <ComboBox fx:id="statusFilter" prefWidth="180" style="-fx-background-color: #f8fafc; -fx-border-color: #e0e3e5; -fx-border-radius: 8; -fx-padding: 4;" />
                <Button fx:id="clearFilterBtn" onAction="#clearFilters" style="-fx-background-color: #fef2f2; -fx-text-fill: #ef4444; -fx-border-color: #fca5a5; -fx-border-radius: 8; -fx-padding: 6 15; -fx-font-weight: bold;" text="مسح الفلاتر" visible="false" />
            </HBox>
        </VBox>

        <!-- Table -->
        <VBox styleClass="admin-section-card" VBox.vgrow="ALWAYS">
            <TableView fx:id="roomTable" prefHeight="400" styleClass="admin-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colName" prefWidth="150" text="اسم / رقم القاعة" />
                    <TableColumn fx:id="colType" prefWidth="150" text="النوع" />
                    <TableColumn fx:id="colBuilding" prefWidth="150" text="المبنى والدور" />
                    <TableColumn fx:id="colCapacity" prefWidth="100" text="السعة" />
                    <TableColumn fx:id="colStatus" prefWidth="150" text="الحالة" />
                    <TableColumn fx:id="colActions" prefWidth="120" text="الإجراءات" />
                </columns>
                <placeholder>
                    <Label styleClass="admin-empty-label" text="لم يتم العثور على قاعات تطابق شروط البحث." />
                </placeholder>
            <stylesheets>
               <URL value="@../../css/dashboard-common.css" />
               <URL value="@../../css/admin.css" />
            </stylesheets>
            </TableView>
        </VBox>
      <stylesheets>
         <URL value="@../../css/dashboard-common.css" />
         <URL value="@../../css/admin.css" />
      </stylesheets>
    </VBox>

    <!-- FORM MODAL OVERLAY -->
    <StackPane fx:id="formModalOverlay" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false">
        <VBox alignment="CENTER" maxHeight="500" maxWidth="500" spacing="20" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 30;">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="formTitle" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #001e40;" text="إضافة قاعة جديدة" HBox.hgrow="ALWAYS" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#closeForm" style="-fx-background-color: transparent; -fx-text-fill: #9ca3af; -fx-font-weight: bold;" text="✖" />
            </HBox>
            
            <VBox spacing="15">
                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #5a7698;" text="الاسم / الرقم التعريفي" />
                    <TextField fx:id="formName" promptText="مثال: A-402" style="-fx-background-color: #f8fafc; -fx-border-color: #e0e3e5; -fx-border-radius: 8; -fx-padding: 10;" />
                </VBox>
                <HBox spacing="15">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #5a7698;" text="نوع القاعة" />
                        <ComboBox fx:id="formType" maxWidth="Infinity" style="-fx-background-color: #f8fafc; -fx-border-color: #e0e3e5; -fx-border-radius: 8; -fx-padding: 4;" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #5a7698;" text="المبنى" />
                        <ComboBox fx:id="formBuilding" maxWidth="Infinity" style="-fx-background-color: #f8fafc; -fx-border-color: #e0e3e5; -fx-border-radius: 8; -fx-padding: 4;" />
                    </VBox>
                </HBox>
                <HBox spacing="15">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #5a7698;" text="الدور" />
                        <ComboBox fx:id="formFloor" maxWidth="Infinity" style="-fx-background-color: #f8fafc; -fx-border-color: #e0e3e5; -fx-border-radius: 8; -fx-padding: 4;" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #5a7698;" text="سعة القاعة (أفراد)" />
                        <TextField fx:id="formCapacity" promptText="20" style="-fx-background-color: #f8fafc; -fx-border-color: #e0e3e5; -fx-border-radius: 8; -fx-padding: 10;" />
                    </VBox>
                </HBox>
                <!-- Only for edit -->
                <VBox fx:id="formStatusContainer" managed="false" spacing="5" visible="false">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #5a7698;" text="الحالة" />
                    <ComboBox fx:id="formStatus" maxWidth="Infinity" style="-fx-background-color: #f8fafc; -fx-border-color: #e0e3e5; -fx-border-radius: 8; -fx-padding: 4;" />
                </VBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 20 0 0 0;">
                <Button onAction="#closeForm" prefWidth="120" style="-fx-background-color: #f2f4f6; -fx-text-fill: #43474f; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 8;" text="إلغاء" />
                <Button fx:id="submitFormBtn" onAction="#submitForm" prefWidth="150" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 8;" text="➕  إضافة القاعة" />
            </HBox>
        </VBox>
    </StackPane>

    <!-- DETAILS MODAL OVERLAY -->
    <StackPane fx:id="detailsModalOverlay" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false">
        <VBox alignment="CENTER" maxHeight="600" maxWidth="550" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 0;">
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 30; -fx-background-color: #f8fafc; -fx-background-radius: 16 16 0 0; -fx-border-color: #e0e3e5; -fx-border-width: 0 0 1 0;">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="detTitle" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #001e40;" text="قاعة A-101" />
                    <Label fx:id="detSubtitle" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="محاضرات عادية" />
                </VBox>
                <Button onAction="#closeDetails" style="-fx-background-color: white; -fx-border-color: #e0e3e5; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #9ca3af; -fx-padding: 8 10;" text="✖" />
            </HBox>
            
            <VBox spacing="20" style="-fx-padding: 30;" VBox.vgrow="ALWAYS">
                <HBox spacing="15">
                    <VBox alignment="CENTER" style="-fx-background-color: #eff6ff; -fx-border-color: #bfdbfe; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="المبنى" />
                        <Label fx:id="detBuilding" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #001e40;" text="A" />
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: #faf5ff; -fx-border-color: #e9d5ff; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="الدور" />
                        <Label fx:id="detFloor" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #001e40;" text="1" />
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: #fff7ed; -fx-border-color: #fed7aa; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="السعة" />
                        <Label fx:id="detCapacity" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #001e40;" text="20 فرد" />
                    </VBox>
                    <VBox fx:id="detStatusContainer" alignment="CENTER" style="-fx-background-color: #f0fdf4; -fx-border-color: #bbf7d0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="الحالة" />
                        <Label fx:id="detStatus" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #15803d;" text="متاحة" />
                    </VBox>
                </HBox>

                <VBox spacing="10" style="-fx-border-color: #e0e3e5; -fx-border-radius: 12; -fx-padding: 20;">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #001e40;" text="📊  إحصائيات الحجوزات" />
                    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-radius: 8;">
                        <Label maxWidth="Infinity" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4b5563;" text="حجوزات نشطة (قادمة أو معلقة)" HBox.hgrow="ALWAYS" />
                        <Label fx:id="detActiveBookings" style="-fx-background-color: #dbeafe; -fx-text-fill: #1e40af; -fx-padding: 4 10; -fx-background-radius: 12; -fx-font-weight: bold;" text="0" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-radius: 8;">
                        <Label maxWidth="Infinity" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4b5563;" text="حجوزات سابقة (أرشيف)" HBox.hgrow="ALWAYS" />
                        <Label fx:id="detHistoryBookings" style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-padding: 4 10; -fx-background-radius: 12; -fx-font-weight: bold;" text="0" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f1f5f9; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 10;">
                        <Label maxWidth="Infinity" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #001e40;" text="إجمالي الحركات على القاعة" HBox.hgrow="ALWAYS" />
                        <Label fx:id="detTotalBookings" style="-fx-background-color: #001e40; -fx-text-fill: white; -fx-padding: 4 10; -fx-background-radius: 12; -fx-font-weight: bold;" text="0" />
                    </HBox>
                </VBox>
            </VBox>

            <VBox style="-fx-padding: 20 30; -fx-border-color: #e0e3e5; -fx-border-width: 1 0 0 0; -fx-background-color: white; -fx-background-radius: 0 0 16 16;">
                <Button maxWidth="Infinity" onAction="#downloadPDF" style="-fx-background-color: #001e40; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8;" text="📄  تحميل تقرير القاعة (PDF)" />
            </VBox>
        </VBox>
    </StackPane>
</StackPane>
