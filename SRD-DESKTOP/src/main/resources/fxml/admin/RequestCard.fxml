<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<!--
  RequestCard.fxml — Admin pending request card
  UI is built entirely in RequestCardController.buildUI()
  mirroring BranchManagerDashboardController.buildCard() style.
  No fx:id labels here — controller populates all children dynamically.
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aast.booking.admin.RequestCardController"
      fx:id="cardRoot"
      styleClass="bm-request-card"
      spacing="12"
      prefWidth="420">

    <stylesheets>
        <URL value="@../../css/branchmanager.css" />
        <URL value="@../../css/admin.css" />
    </stylesheets>

    <padding><Insets bottom="22" left="22" right="22" top="22" /></padding>

    <!-- All children are added programmatically by RequestCardController.buildUI() -->

</VBox>
