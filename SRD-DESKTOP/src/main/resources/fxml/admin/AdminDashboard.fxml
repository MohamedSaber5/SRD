<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT"
            style="-fx-background-color: #f2f4f6;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aast.booking.admin.AdminDashboardController">

    <stylesheets>
        <java.lang.String fx:value="/css/styles.css" />
        <java.lang.String fx:value="/css/admin.css" />
    </stylesheets>

    <!-- SIDEBAR (left in code = RIGHT visually in RTL) -->
    <left>
        <VBox spacing="6" styleClass="admin-sidebar">
            <padding><Insets bottom="20" left="16" right="16" top="24" /></padding>

            <!-- Brand -->
            <VBox alignment="CENTER" spacing="4" style="-fx-padding: 0 0 16 0;">
                <javafx.scene.image.ImageView fitHeight="60" fitWidth="60" preserveRatio="true" smooth="true">
                    <image><javafx.scene.image.Image url="@../../images/logo_aast.jpg" /></image>
                </javafx.scene.image.ImageView>
                <Label styleClass="admin-sidebar-title" text="نظام حجز القاعات" wrapText="true" textAlignment="CENTER" />
                <Label styleClass="admin-sidebar-subtitle" text="الأكاديمية العربية للعلوم والتكنولوجيا" wrapText="true" textAlignment="CENTER" />
                <Label fx:id="roleLabel" styleClass="admin-role-badge" text="المسؤول العام" />
            </VBox>

            <Region maxWidth="Infinity" styleClass="admin-divider" />

            <Label fx:id="welcomeLabel" style="-fx-padding: 8 4 4 4; -fx-font-style:italic;" styleClass="admin-sidebar-subtitle" text="" wrapText="true" />

            <!-- Navigation -->
            <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#showDashboard" styleClass="admin-nav-btn-active" text="🏛  مدير النظام" />
            <Button fx:id="btnRequests" maxWidth="Infinity" onAction="#showPendingRequests" styleClass="admin-nav-btn" text="📋  الطلبات المعلقة" />
            <Button fx:id="btnNewBooking" maxWidth="Infinity" onAction="#showNewBooking" styleClass="admin-nav-btn" text="➕  طلب حجز جديد" />
            <Button fx:id="btnRoomMgmt" maxWidth="Infinity" onAction="#showRoomManagement" styleClass="admin-nav-btn" text="🏢  إدارة القاعات" />
            <Button fx:id="btnSearch" maxWidth="Infinity" onAction="#showSearch" styleClass="admin-nav-btn" text="🔍  البحث المتقدم" />
            <Button fx:id="btnDelegation" maxWidth="Infinity" onAction="#showDelegation" styleClass="admin-nav-btn" text="👥  الصلاحيات والتفويض" />
            <Button fx:id="btnSettings" maxWidth="Infinity" onAction="#showSettings" styleClass="admin-nav-btn" text="⚙  الإعدادات" />
            <Button fx:id="btnStats" maxWidth="Infinity" onAction="#showStatistics" styleClass="admin-nav-btn" text="📊  الإحصائيات والتقارير" />

            <Region VBox.vgrow="ALWAYS" />

            <Region maxWidth="Infinity" styleClass="admin-divider" />
            <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="admin-logout-btn" text="🚪  تسجيل الخروج" />
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" styleClass="admin-main-scroll"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="0" style="-fx-background-color: #f2f4f6;">

                <!-- Top Header -->
                <HBox alignment="CENTER_RIGHT" spacing="16" styleClass="admin-header">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="pageTitle" styleClass="admin-header-title" text="لوحة تحكم المسؤول" />
                        <Label fx:id="pageSubtitle" styleClass="admin-header-subtitle" text="إدارة الجداول الأسبوعية ومتابعة العمليات" />
                    </VBox>
                    <Button fx:id="ramadanBtn" onAction="#toggleRamadanMode" styleClass="admin-ramadan-off" text="🌙  تفعيل وضع رمضان" />
                </HBox>

                <!-- Page Stack -->
                <StackPane VBox.vgrow="ALWAYS" style="-fx-min-height: 650;">

                    <!-- HOME / DASHBOARD VIEW -->
                    <VBox fx:id="dashboardView" spacing="28" visible="true">
                        <padding><Insets bottom="30" left="30" right="30" top="28" /></padding>

                        <!-- Stats Row -->
                        <HBox spacing="16">
                            <!-- Card 1: Accepted Today -->
                            <VBox spacing="10" styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                    <Label styleClass="admin-stat-icon, admin-stat-icon-blue" text="📋" style="-fx-font-size: 18px;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label styleClass="admin-stat-badge-green" text="اليوم" />
                                </HBox>
                                <Label styleClass="admin-stat-label" text="الطلبات المقبولة اليوم" />
                                <Label fx:id="statAcceptedToday" styleClass="admin-stat-value" text="0" />
                            </VBox>
                            <!-- Card 2: Pending -->
                            <VBox spacing="10" styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_RIGHT">
                                    <Label styleClass="admin-stat-icon, admin-stat-icon-gold" text="⏳" style="-fx-font-size: 18px;" />
                                </HBox>
                                <Label styleClass="admin-stat-label" text="الطلبات قيد الانتظار" />
                                <Label fx:id="statPendingCount" styleClass="admin-stat-value-gold" text="0" />
                            </VBox>
                            <!-- Card 3: Total Bookings -->
                            <VBox spacing="10" styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_RIGHT">
                                    <Label styleClass="admin-stat-icon, admin-stat-icon-green" text="✓" style="-fx-font-size: 18px;" />
                                </HBox>
                                <Label styleClass="admin-stat-label" text="إجمالي الحجوزات" />
                                <Label fx:id="statTotalBookings" styleClass="admin-stat-value-green" text="0" />
                            </VBox>
                            <!-- Card 4: Total Rooms -->
                            <VBox spacing="10" styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_RIGHT">
                                    <Label styleClass="admin-stat-icon, admin-stat-icon-blue" text="🏢" style="-fx-font-size: 18px;" />
                                </HBox>
                                <Label styleClass="admin-stat-label" text="القاعات المسجلة" />
                                <Label fx:id="statTotalRooms" styleClass="admin-stat-value" text="0" />
                            </VBox>
                        </HBox>

                        <!-- Today's Events Section -->
                        <VBox spacing="16" styleClass="admin-section-card">
                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <Label styleClass="admin-section-title" text="📅  أحداث اليوم" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="todayDateLabel" style="-fx-font-size: 13px; -fx-text-fill: #737780; -fx-font-weight: bold;" text="" />
                            </HBox>
                            <Label styleClass="admin-section-subtitle" text="حجوزات اليوم الاستثنائية والقاعات متعددة الأغراض" />

                            <TableView fx:id="todayEventsTable" styleClass="admin-table"
                                       prefHeight="280" style="-fx-min-height: 200;">
                                <columns>
                                    <TableColumn fx:id="evColRoom"    prefWidth="140" text="القاعة" />
                                    <TableColumn fx:id="evColType"    prefWidth="160" text="نوع الحدث" />
                                    <TableColumn fx:id="evColUser"    prefWidth="170" text="المسؤول" />
                                    <TableColumn fx:id="evColTime"    prefWidth="130" text="الوقت" />
                                    <TableColumn fx:id="evColPurpose" prefWidth="220" text="الغرض / المادة" />
                                </columns>
                                <placeholder>
                                    <Label styleClass="admin-empty-label" text="لا توجد حجوزات استثنائية لهذا اليوم" />
                                </placeholder>
                            </TableView>
                        </VBox>

                        <!-- Quick Actions -->
                        <HBox spacing="14">
                            <Button onAction="#showPendingRequests" styleClass="admin-action-btn" text="📋  إدارة الطلبات المعلقة" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                            <Button onAction="#showNewBooking" styleClass="admin-primary-btn" text="➕  طلب حجز جديد" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                            <Button onAction="#showStatistics" styleClass="admin-primary-btn" text="📊  الإحصائيات" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        </HBox>
                    </VBox>

                    <!-- PENDING REQUESTS VIEW -->
                    <VBox fx:id="pendingView" spacing="20" visible="false">
                        <padding><Insets bottom="30" left="30" right="30" top="24" /></padding>
                        <HBox alignment="CENTER_RIGHT" spacing="12">
                            <Label styleClass="admin-section-title" text="📋  الطلبات المعلقة" />
                            <Label fx:id="lblPendingCount" styleClass="admin-count-badge" text="0" />
                            <Region HBox.hgrow="ALWAYS" />
                        </HBox>
                        <!-- Cards container matching branch manager style -->
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                    style="-fx-min-height: 400; -fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
                            <FlowPane fx:id="requestsContainer" hgap="20" vgap="20" prefWrapLength="800">
                                <padding><Insets bottom="16" left="4" right="4" top="8" /></padding>
                            </FlowPane>
                        </ScrollPane>
                    </VBox>
                    <VBox fx:id="newBookingView" visible="false" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
                        <fx:include fx:id="newBookingForm" source="AdminBookingForm.fxml" VBox.vgrow="ALWAYS" />
                    </VBox>

                    <VBox fx:id="roomMgmtView" visible="false" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
                        <fx:include source="RoomManagement.fxml" VBox.vgrow="ALWAYS" />
                    </VBox>
                    <VBox fx:id="searchView" visible="false" VBox.vgrow="ALWAYS">
                        <fx:include source="AdvancedSearch.fxml" VBox.vgrow="ALWAYS" />
                    </VBox>
                    <VBox fx:id="delegationView" visible="false" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
                        <fx:include source="AdminDelegation.fxml" VBox.vgrow="ALWAYS" />
                    </VBox>
                    <VBox fx:id="settingsView" spacing="20" visible="false" alignment="CENTER">
                        <padding><Insets bottom="60" left="60" right="60" top="60" /></padding>
                        <Label style="-fx-font-size: 28px;" text="⚙" />
                        <Label styleClass="admin-section-title" text="الإعدادات" />
                        <Label styleClass="admin-section-subtitle" text="هذا القسم سيتم تفعيله قريباً" />
                    </VBox>
                    <VBox fx:id="statsView" visible="false" VBox.vgrow="ALWAYS">
                        <fx:include source="AdminStatistics.fxml" />
                    </VBox>

                    <!-- OVERLAYS / MODALS -->
                    <!-- Approve Modal -->
                    <StackPane fx:id="approveModalOverlay" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false">
                        <VBox alignment="CENTER" maxWidth="500" maxHeight="350" spacing="20" styleClass="admin-section-card" style="-fx-background-color: #ffffff;">
                            <Label styleClass="admin-section-title" text="اعتماد وتخصيص قاعة" />
                            <Label fx:id="lblApproveDetails" styleClass="admin-section-subtitle" text="جاري البحث عن القاعات المتاحة..." wrapText="true" />
                            
                            <VBox spacing="8" alignment="CENTER_RIGHT" fx:id="vboxAvailableRooms">
                                <Label styleClass="info-box-title" text="اختر القاعة المناسبة" />
                                <javafx.scene.control.ComboBox fx:id="cmbAvailableRooms" prefWidth="400" />
                            </VBox>
                            
                            <javafx.scene.control.CheckBox fx:id="chkUrgent" text="طلب عاجل (تجاوز فترة الـ 48 ساعة)" visible="false" />
                            
                            <HBox spacing="16" alignment="CENTER">
                                <Button onAction="#confirmApprove" styleClass="admin-primary-btn" text="تأكيد الاعتماد" prefWidth="150" />
                                <Button onAction="#closeModals" styleClass="btn-reject-card" text="إلغاء" prefWidth="100" />
                            </HBox>
                        </VBox>
                    </StackPane>

                    <!-- Reject Modal -->
                    <StackPane fx:id="rejectModalOverlay" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false">
                        <VBox alignment="CENTER" maxWidth="520" spacing="16" styleClass="admin-section-card" style="-fx-background-color: #ffffff; -fx-padding: 28;">
                            <Label styleClass="admin-section-title" text="رفض الطلب واقتراح بدائل" />
                            
                            <VBox spacing="6" alignment="CENTER_RIGHT">
                                <Label styleClass="info-box-title" text="سبب الرفض *" />
                                <javafx.scene.control.TextArea fx:id="txtRejectReason" prefRowCount="3" promptText="أدخل سبب الرفض هنا..." maxWidth="Infinity" />
                            </VBox>
                            
                            <Label styleClass="admin-section-subtitle" text="خيارات بديلة (اختياري)" />
                            
                            <HBox spacing="10">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label styleClass="info-box-title" text="قاعة بديلة" />
                                    <javafx.scene.control.ComboBox fx:id="cmbSuggestedRoom" promptText="اختر قاعة بديلة" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                                </VBox>
                                <VBox spacing="4">
                                    <Label styleClass="info-box-title" text="تاريخ بديل" />
                                    <javafx.scene.control.DatePicker fx:id="dpSuggestedDate" promptText="تاريخ بديل" />
                                </VBox>
                            </HBox>
                            
                            <VBox spacing="4">
                                <Label styleClass="info-box-title" text="وقت بديل" />
                                <javafx.scene.control.ComboBox fx:id="cmbSuggestedSlot" promptText="اختر وقتاً بديلاً" maxWidth="Infinity" />
                            </VBox>
                            
                            <HBox spacing="16" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                                <Button onAction="#confirmReject" styleClass="btn-reject-card" style="-fx-text-fill: #ba1a1a; -fx-border-color: #ba1a1a;" text="تأكيد الرفض" prefWidth="150" />
                                <Button onAction="#closeModals" styleClass="btn-reject-card" text="إلغاء" prefWidth="100" />
                            </HBox>
                        </VBox>
                    </StackPane>

                    <!-- Booking Detail Popup Overlay -->
                    <StackPane fx:id="detailOverlay" style="-fx-background-color: rgba(15,23,42,0.55);" visible="false">
                        <VBox fx:id="detailCard" alignment="TOP_RIGHT" maxWidth="560" spacing="0"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 40, 0, 0, 8); -fx-opacity: 0;">
                            <!-- Header -->
                            <HBox alignment="CENTER_RIGHT" spacing="10"
                                  style="-fx-background-color: #1a2a4a; -fx-background-radius: 20 20 0 0; -fx-padding: 18 24;">
                                <Label fx:id="detailTitle" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;" text="تفاصيل الطلب" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="detailStatusBadge" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #f59e0b; -fx-background-radius: 20; -fx-padding: 4 12;" text="قيد الانتظار" />
                                <Button onAction="#closeDetailOverlay" style="-fx-background-color: transparent; -fx-text-fill: #aab; -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 0 4;" text="✕" />
                            </HBox>
                            <!-- Body -->
                            <VBox spacing="14" style="-fx-padding: 22 24;">
                                <!-- Row 1: Date/Time + Requester -->
                                <HBox spacing="14">
                                    <VBox spacing="4" style="-fx-background-color: #eef4ff; -fx-background-radius: 10; -fx-padding: 12;" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="📅  التاريخ والوقت" />
                                        <Label fx:id="detailDate" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e3a6e;" text="-" />
                                        <Label fx:id="detailTime" style="-fx-font-size: 13px; -fx-text-fill: #3b82f6;" text="-" />
                                    </VBox>
                                    <VBox spacing="4" style="-fx-background-color: #f0fdf4; -fx-background-radius: 10; -fx-padding: 12;" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="👤  مقدم الطلب" />
                                        <Label fx:id="detailRequester" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #166534;" text="-" wrapText="true" />
                                        <Label fx:id="detailResponsible" style="-fx-font-size: 12px; -fx-text-fill: #4ade80;" text="-" wrapText="true" />
                                    </VBox>
                                </HBox>
                                <!-- Row 2: Capacity + Room Type -->
                                <HBox spacing="14">
                                    <VBox spacing="4" style="-fx-background-color: #fff7ed; -fx-background-radius: 10; -fx-padding: 12;" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="👥  السعة المطلوبة" />
                                        <Label fx:id="detailCapacity" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #c2410c;" text="-" />
                                    </VBox>
                                    <VBox spacing="4" style="-fx-background-color: #faf5ff; -fx-background-radius: 10; -fx-padding: 12;" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="🏢  نوع القاعة" />
                                        <Label fx:id="detailRoomType" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;" text="-" />
                                    </VBox>
                                </HBox>
                                <!-- Purpose -->
                                <VBox spacing="4" style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-padding: 12;">
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="📝  الغرض من الاستخدام" />
                                    <Label fx:id="detailPurpose" style="-fx-font-size: 14px; -fx-text-fill: #334155;" text="-" wrapText="true" />
                                </VBox>
                                <!-- Requirements -->
                                <VBox fx:id="detailRequirementsBox" spacing="6" style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-padding: 12;">
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="⚙  المتطلبات" />
                                    <Label fx:id="detailRequirements" style="-fx-font-size: 13px; -fx-text-fill: #475569;" text="-" wrapText="true" />
                                </VBox>
                            </VBox>
                        </VBox>
                    </StackPane>
                </StackPane>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
