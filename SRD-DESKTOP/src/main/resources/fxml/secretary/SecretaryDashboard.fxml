<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aast.booking.secretary.SecretaryDashboardController"
            style="-fx-background-color: #F5F7FA;"
            nodeOrientation="RIGHT_TO_LEFT">
    <stylesheets>
        <java.lang.String fx:value="/css/styles.css"/>
        <java.lang.String fx:value="/css/dashboard-common.css"/>
    </stylesheets>

    <!-- ═══ SIDEBAR (Left) ═══════════════════════════════════════════ -->
    <left>
        <VBox styleClass="bm-sidebar" spacing="6">
            <padding><Insets top="24" right="16" bottom="20" left="16"/></padding>

            <!-- Logo / Title -->
            <VBox spacing="2" style="-fx-padding: 0 0 16 0;">
                <Label text="نظام حجز القاعات" styleClass="bm-sidebar-title" wrapText="true"/>
                <Label text="الأكاديمية العربية" styleClass="bm-sidebar-subtitle"/>
                <Label text="سكرتير" style="-fx-font-size:11px;-fx-text-fill:#D4AF37;-fx-font-weight:bold;"/>
            </VBox>

            <!-- Divider -->
            <Region styleClass="bm-divider" maxWidth="Infinity"/>

            <!-- Welcome -->
            <Label fx:id="userNameLabel" text="مرحباً" styleClass="bm-sidebar-subtitle" wrapText="true"
                   style="-fx-padding: 8 4; -fx-font-style:italic;"/>

            <!-- Nav Buttons -->
            <Button fx:id="btnDashboard" text="🏠  لوحة التحكم" maxWidth="Infinity"
                    styleClass="bm-nav-btn-active" onAction="#showDashboard"/>
            <Button fx:id="btnNewBookingMenu" text="📋  طلب حجز جديد" maxWidth="Infinity"
                    styleClass="bm-nav-btn" onAction="#showNewBooking"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Logout -->
            <Region styleClass="bm-divider" maxWidth="Infinity"/>
            <Button text="🚪  تسجيل الخروج" maxWidth="Infinity"
                    styleClass="bm-logout-btn" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ═══ MAIN CONTENT ═════════════════════════════════════════════ -->
    <center>
        <VBox spacing="0">

            <!-- ─── Top Header ───────────────────────────────────── -->
            <HBox styleClass="bm-header" alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="pageTitle" text="لوحة التحكم" styleClass="bm-header-title"/>
                    <Label fx:id="pageSubtitle" text="نظرة عامة على سجل طلبات الحجز" styleClass="bm-header-subtitle"/>
                </VBox>
            </HBox>

            <!-- ─── Page Content (Stack) ─────────────────────────── -->
            <StackPane fx:id="mainContentArea" VBox.vgrow="ALWAYS">

                <!-- ══ DASHBOARD VIEW ══════════════════════════════ -->
                <VBox fx:id="dashboardView" spacing="20" visible="true">
                    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

                    <!-- Notification Banner -->
                    <Label fx:id="notificationLabel" text="نظرة عامة على سجل طلبات الحجز الخاصة بك."
                           style="-fx-font-size:13px; -fx-text-fill:#1e40af; -fx-background-color:#EFF6FF; -fx-padding:12 20; -fx-background-radius:10; -fx-border-color:#BFDBFE; -fx-border-radius:10; -fx-border-width:1;" maxWidth="Infinity"/>

                    <!-- Stat Cards Row -->
                    <HBox fx:id="statsHBox" spacing="16"/>

                    <!-- Section Title -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="حالة الطلبات الأخيرة" styleClass="bm-section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="↻  تحديث" onAction="#handleRefresh"
                                style="-fx-background-color:#E8F0FE;-fx-text-fill:#003087;-fx-font-weight:bold;-fx-background-radius:10;-fx-padding:8 16;-fx-cursor:hand;-fx-border-color:transparent;"/>
                        <Button text="+  طلب حجز جديد" onAction="#showNewBooking"
                                style="-fx-background-color:#003087;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:10;-fx-padding:8 16;-fx-cursor:hand;-fx-border-color:transparent;"/>
                    </HBox>

                    <!-- Cards Scroll Area -->
                    <ScrollPane styleClass="bm-scroll" VBox.vgrow="ALWAYS" fitToWidth="true">
                        <VBox fx:id="recentRequestsList" spacing="12">
                            <padding><Insets top="4" right="4" bottom="16" left="4"/></padding>
                        </VBox>
                    </ScrollPane>
                </VBox>

                <!-- ══ NEW BOOKING VIEW ════════════════════════════ -->
                <ScrollPane fx:id="newBookingView" fitToWidth="true" styleClass="bm-scroll" visible="false">
                    <VBox alignment="TOP_CENTER" spacing="24" style="-fx-padding: 24;">

                        <!-- Stepper UI -->
                        <HBox alignment="CENTER" spacing="80" style="-fx-padding: 0 0 10 0;">
                            <VBox alignment="CENTER" spacing="10">
                                <StackPane style="-fx-background-color: #003087; -fx-background-radius: 50%; -fx-min-width: 40; -fx-min-height: 40;">
                                    <Label text="1" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                                </StackPane>
                                <Label text="التفاصيل" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                            </VBox>
                            <VBox alignment="CENTER" spacing="10">
                                <StackPane style="-fx-background-color: #e2e8f0; -fx-background-radius: 50%; -fx-min-width: 40; -fx-min-height: 40;">
                                    <Label text="2" style="-fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                                </StackPane>
                                <Label text="المسؤول" style="-fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                            </VBox>
                            <VBox alignment="CENTER" spacing="10">
                                <StackPane style="-fx-background-color: #e2e8f0; -fx-background-radius: 50%; -fx-min-width: 40; -fx-min-height: 40;">
                                    <Label text="3" style="-fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                                </StackPane>
                                <Label text="التجهيزات" style="-fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                            </VBox>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="20" maxWidth="800">
                            <Label text="طلب حجز جديد" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #003087;"/>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="تكرار الحجز السابق" onAction="#handleCloneLastBooking"
                                    style="-fx-background-color:#F3F4F6;-fx-text-fill:#374151;-fx-border-color:#E5E7EB;-fx-border-radius:10;-fx-background-radius:10;-fx-padding:8 16;-fx-cursor:hand;-fx-font-weight:bold;"/>
                            <Button text="تراجع عن الإدخال" onAction="#handleUndoForm"
                                    style="-fx-background-color:#FEE2E2;-fx-text-fill:#B91C1C;-fx-border-color:#FCA5A5;-fx-border-radius:10;-fx-background-radius:10;-fx-padding:8 16;-fx-cursor:hand;-fx-font-weight:bold;"/>
                        </HBox>

                        <!-- STEP 1: EVENT DETAILS -->
                        <VBox spacing="20" maxWidth="800" styleClass="bm-form-card">
                            <Label text="1. تفاصيل الفعالية" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#003087;"/>

                            <!-- Fixed Room Banner -->
                            <VBox alignment="CENTER" spacing="8" style="-fx-background-color:#F9FAFB;-fx-border-color:#E5E7EB;-fx-border-radius:12;-fx-padding:20;-fx-background-radius:12;">
                                <Label text="🏛" style="-fx-font-size: 24px;"/>
                                <Label text="قاعة متعددة الأغراض" style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:#003087;"/>
                                <Label text="للندوات، الاجتماعات، والفعاليات الرسمية" style="-fx-font-size:12px;-fx-text-fill:#6B7280;"/>
                            </VBox>

                            <HBox spacing="20">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="تاريخ الفعالية" styleClass="bm-form-field-label"/>
                                    <DatePicker fx:id="datePicker" onAction="#saveFormState" promptText="mm/dd/yyyy" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="الفترة الزمنية" styleClass="bm-form-field-label"/>
                                    <HBox spacing="10">
                                        <ComboBox fx:id="timeFromCombo" onAction="#saveFormState" promptText="من الساعة..." maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                        <ComboBox fx:id="timeToCombo" onAction="#saveFormState" promptText="إلى الساعة..." maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                </VBox>
                            </HBox>

                            <VBox spacing="6">
                                <Label text="الغرض من الاستخدام" styleClass="bm-form-field-label"/>
                                <TextField fx:id="purposeField" onKeyReleased="#saveFormState" promptText="وصف موجز لطبيعة الفعالية أو الاجتماع..."/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="السعة المطلوبة (عدد الحضور المتوقع)" styleClass="bm-form-field-label"/>
                                <TextField fx:id="capacityField" onKeyReleased="#saveFormState" promptText="مثال: 50"/>
                            </VBox>

                            <VBox spacing="12" style="-fx-background-color:#F9FAFB;-fx-padding:16;-fx-background-radius:10;">
                                <Label text="امتيازات إضافية" styleClass="bm-form-field-label"/>
                                <CheckBox fx:id="cbHoliday" text="حدث خلال عطلة رسمية أو إجازة نهاية الأسبوع" onAction="#saveFormState" style="-fx-font-size:13px;-fx-font-weight:bold;"/>
                                <Label text="يضيف نقاط أولوية للطلب عند مدير الفرع" style="-fx-font-size:11px;-fx-text-fill:#9CA3AF;-fx-padding:0 0 0 24;"/>
                                <CheckBox fx:id="cbOfficial" text="مناسبة رسمية للكلية (مؤتمر مسجل، ندوة عامة)" onAction="#saveFormState" style="-fx-font-size:13px;-fx-font-weight:bold;"/>
                                <Label text="يرجى توضيح التفاصيل في خانة الغرض من الاستخدام" style="-fx-font-size:11px;-fx-text-fill:#9CA3AF;-fx-padding:0 0 0 24;"/>
                            </VBox>
                        </VBox>

                        <!-- STEP 2: RESPONSIBLE PERSON -->
                        <VBox spacing="20" maxWidth="800" styleClass="bm-form-card">
                            <Label text="2. بيانات المسؤول عن الحدث" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#003087;"/>

                            <VBox spacing="6">
                                <Label text="الاسم" styleClass="bm-form-field-label"/>
                                <TextField fx:id="requesterNameField" onKeyReleased="#saveFormState" promptText="أدخل الاسم (نص فقط)"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="الوظيفة / الصفة الأكاديمية" styleClass="bm-form-field-label"/>
                                <TextField fx:id="requesterTitleField" onKeyReleased="#saveFormState" promptText="مثال: أستاذ دكتور بكلية الهندسة"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="رقم الجوال (للتواصل السريع)" styleClass="bm-form-field-label"/>
                                <TextField fx:id="requesterPhoneField" onKeyReleased="#saveFormState" promptText="مثال: 0123456789"/>
                            </VBox>
                        </VBox>

                        <!-- STEP 3: REQUIREMENTS -->
                        <VBox spacing="20" maxWidth="800" styleClass="bm-form-card">
                            <Label text="3. المتطلبات التقنية واللوجستية" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#003087;"/>

                            <VBox spacing="12">
                                <CheckBox fx:id="cbLaptop" text="جهاز حاسب آلي (Laptop)" onAction="#saveFormState" style="-fx-font-size:13px;-fx-font-weight:bold;"/>
                                <Label text="توفير جهاز آلي متصل بشاشة العرض" style="-fx-font-size:11px;-fx-text-fill:#9CA3AF;-fx-padding:0 0 0 24;"/>

                                <CheckBox fx:id="cbVideoConf" text="نظام الـ Video Conference" onAction="#saveFormState" style="-fx-font-size:13px;-fx-font-weight:bold;"/>
                                <Label text="تجهيز كاميرات ومنصات البث للاجتماع عن بُعد" style="-fx-font-size:11px;-fx-text-fill:#9CA3AF;-fx-padding:0 0 0 24;"/>

                                <CheckBox fx:id="cbMic" text="ميكروفونات متحركة" onAction="#saveFormState" style="-fx-font-size:13px;-fx-font-weight:bold;"/>
                                <Label text="توفير ميكروفونات لاسلكية للأسئلة أو الحوار" style="-fx-font-size:11px;-fx-text-fill:#9CA3AF;-fx-padding:0 0 0 24;"/>
                            </VBox>

                            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 16 0 0 0;">
                                <Button text="⚡  تأكيد وإرسال الطلب" onAction="#handleSubmitBooking" maxWidth="Infinity"
                                        styleClass="bm-approve-btn" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </ScrollPane>

            </StackPane>
        </VBox>
    </center>
</BorderPane>
