<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aast.booking.auth.RegisterController"
      styleClass="root-container"
      prefWidth="1000" prefHeight="720">

    <!-- ═══ LEFT PANEL: Branding ═════════════════════════════════════════ -->
    <VBox styleClass="brand-panel" HBox.hgrow="ALWAYS" alignment="CENTER"
          minWidth="380">
        <padding><Insets top="60" bottom="60" left="60" right="40"/></padding>

        <Label styleClass="brand-title" text="إنشاء حساب جديد" wrapText="true" maxWidth="300"/>

        <Region VBox.vgrow="SOMETIMES" maxHeight="24"/>

        <Label styleClass="brand-body"
               text="أنشئ حسابك للوصول إلى نظام حجز القاعات بالأكاديمية العربية"
               wrapText="true" maxWidth="300"/>

        <Region VBox.vgrow="SOMETIMES" maxHeight="40"/>

        <HBox alignment="CENTER_RIGHT" spacing="8">
            <Region styleClass="dot-accent"/>
            <Region styleClass="dot-accent" opacity="0.6"/>
            <Region styleClass="dot-accent" opacity="0.3"/>
        </HBox>
    </VBox>

    <!-- ═══ RIGHT PANEL: Register Form ══════════════════════════════════ -->
    <VBox styleClass="form-panel" alignment="CENTER" minWidth="460" maxWidth="460">
        <padding><Insets top="50" bottom="50" left="50" right="50"/></padding>

        <Label styleClass="logo-icon" text="📝"/>

        <Region VBox.vgrow="SOMETIMES" maxHeight="12"/>

        <Label styleClass="form-title" text="إنشاء حساب"/>
        <Label styleClass="form-subtitle" text="سجّل بياناتك للانضمام للنظام"/>

        <Region VBox.vgrow="SOMETIMES" maxHeight="20"/>

        <!-- Error label -->
        <Label fx:id="errorLabel" styleClass="error-label"
               text="" wrapText="true" maxWidth="360"
               managed="${errorLabel.visible}"/>

        <Region VBox.vgrow="SOMETIMES" maxHeight="6"/>

        <!-- Full Name -->
        <VBox spacing="6" maxWidth="360" prefWidth="360">
            <Label styleClass="field-label" text="الاسم الكامل"/>
            <TextField fx:id="nameField" styleClass="text-field"
                       promptText="أدخل اسمك الكامل" prefHeight="46"/>
        </VBox>

        <Region VBox.vgrow="SOMETIMES" maxHeight="12"/>

        <!-- Employee ID -->
        <VBox spacing="6" maxWidth="360" prefWidth="360">
            <Label styleClass="field-label" text="الرقم الوظيفي"/>
            <TextField fx:id="employeeIdField" styleClass="text-field"
                       promptText="أدخل الرقم الوظيفي" prefHeight="46"/>
        </VBox>

        <Region VBox.vgrow="SOMETIMES" maxHeight="12"/>

        <!-- Role -->
        <VBox spacing="6" maxWidth="360" prefWidth="360">
            <Label styleClass="field-label" text="الدور الوظيفي"/>
            <ComboBox fx:id="roleComboBox" styleClass="combo-box"
                      maxWidth="360" prefWidth="360" prefHeight="46"/>
        </VBox>

        <Region VBox.vgrow="SOMETIMES" maxHeight="12"/>

        <!-- Password -->
        <VBox spacing="6" maxWidth="360" prefWidth="360">
            <Label styleClass="field-label" text="كلمة المرور"/>
            <PasswordField fx:id="passwordField" styleClass="text-field"
                           promptText="6 أحرف على الأقل" prefHeight="46"/>
        </VBox>

        <Region VBox.vgrow="SOMETIMES" maxHeight="12"/>

        <!-- Confirm Password -->
        <VBox spacing="6" maxWidth="360" prefWidth="360">
            <Label styleClass="field-label" text="تأكيد كلمة المرور"/>
            <PasswordField fx:id="confirmPasswordField" styleClass="text-field"
                           promptText="أعد إدخال كلمة المرور" prefHeight="46"/>
        </VBox>

        <Region VBox.vgrow="SOMETIMES" maxHeight="20"/>

        <!-- Register button -->
        <Button fx:id="registerButton"
                styleClass="primary-button"
                text="إنشاء الحساب"
                maxWidth="360" prefWidth="360" prefHeight="50"
                onAction="#handleRegister"/>

        <Region VBox.vgrow="SOMETIMES" maxHeight="16"/>

        <!-- Back to login -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="لديك حساب بالفعل؟" styleClass="link-text"/>
            <Hyperlink fx:id="goToLoginLink" text="تسجيل الدخول"
                       styleClass="link-hyperlink"
                       onAction="#goToLogin"/>
        </HBox>

    </VBox>
</HBox>
