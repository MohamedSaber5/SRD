<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aast.booking.auth.LoginController"
      styleClass="root-container"
      prefWidth="1000" prefHeight="680">

    <!-- ═══ LEFT PANEL: Branding ═════════════════════════════════════════ -->
    <VBox styleClass="brand-panel" HBox.hgrow="ALWAYS" alignment="CENTER"
          minWidth="400">
        <padding><Insets top="60" bottom="60" left="60" right="40"/></padding>

        <Label styleClass="brand-title"
               text="نظام حجز القاعات" wrapText="true" maxWidth="320"/>
        <Label styleClass="brand-subtitle" text="والفعاليات"
               wrapText="true" maxWidth="320"/>

        <Region VBox.vgrow="SOMETIMES" maxHeight="30"/>

        <Label styleClass="brand-body"
               text="الأكاديمية العربية للعلوم والتكنولوجيا والنقل البحري"
               wrapText="true" maxWidth="320"/>

        <Region VBox.vgrow="SOMETIMES" maxHeight="40"/>

        <!-- Decorative dots -->
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <Region styleClass="dot-accent"/>
            <Region styleClass="dot-accent" opacity="0.6"/>
            <Region styleClass="dot-accent" opacity="0.3"/>
        </HBox>
    </VBox>

    <!-- ═══ RIGHT PANEL: Login Form ══════════════════════════════════════ -->
    <VBox styleClass="form-panel" alignment="CENTER" minWidth="420" maxWidth="420">
        <padding><Insets top="60" bottom="60" left="50" right="50"/></padding>

        <!-- Logo placeholder -->
        <Label styleClass="logo-icon" text="🎓"/>

        <Region VBox.vgrow="SOMETIMES" maxHeight="16"/>

        <Label styleClass="form-title" text="تسجيل الدخول"/>
        <Label styleClass="form-subtitle"
               text="مرحباً بك في نظام حجز القاعات بالأكاديمية"/>

        <Region VBox.vgrow="SOMETIMES" maxHeight="28"/>

        <!-- Error label -->
        <Label fx:id="errorLabel" styleClass="error-label"
               text="" wrapText="true" maxWidth="320"
               managed="${errorLabel.visible}"/>

        <Region VBox.vgrow="SOMETIMES" maxHeight="8"/>

        <!-- Employee ID field -->
        <VBox spacing="6" maxWidth="320" prefWidth="320">
            <Label styleClass="field-label" text="الرقم الوظيفي"/>
            <TextField fx:id="employeeIdField"
                       styleClass="text-field"
                       promptText="أدخل الرقم الوظيفي"
                       prefHeight="48"/>
        </VBox>

        <Region VBox.vgrow="SOMETIMES" maxHeight="16"/>

        <!-- Password field -->
        <VBox spacing="6" maxWidth="320" prefWidth="320">
            <Label styleClass="field-label" text="كلمة المرور"/>
            <PasswordField fx:id="passwordField"
                           styleClass="text-field"
                           promptText="••••••••"
                           prefHeight="48"/>
        </VBox>

        <Region VBox.vgrow="SOMETIMES" maxHeight="24"/>

        <!-- Login button -->
        <Button fx:id="loginButton"
                styleClass="primary-button"
                text="تسجيل الدخول"
                maxWidth="320" prefWidth="320" prefHeight="52"
                onAction="#handleLogin"/>

        <!-- Loading indicator -->
        <HBox fx:id="loadingBox" alignment="CENTER" spacing="8"
              managed="${loadingBox.visible}">
            <ProgressIndicator styleClass="loading-spinner" prefWidth="20" prefHeight="20"/>
            <Label fx:id="loadingLabel" text="جاري التحقق من بياناتك..." styleClass="loading-label"/>
        </HBox>

        <Region VBox.vgrow="SOMETIMES" maxHeight="20"/>

        <!-- Register link -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="ليس لديك حساب؟" styleClass="link-text"/>
            <Hyperlink fx:id="goToRegisterLink" text="إنشاء حساب جديد"
                       styleClass="link-hyperlink"
                       onAction="#goToRegister"/>
        </HBox>

    </VBox>
</HBox>
